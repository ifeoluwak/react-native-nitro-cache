{
  "cxxNamespace": ["nitrocache"],
  "ios": {
    "iosModuleName": "NitroCache"
  },
  "android": {
    "androidNamespace": ["nitrocache"],
    "androidCxxLibName": "nitrocache"
  },
  "autolinking": {
    "NitroCache": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNitroCache"
      }
    },
    "NitroCacheFolder": {
      "ios": {
        "language": "swift",
        "implementationClassName": "NitroCacheFolder"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "NitroCacheFolder"
      }
    }
  },
  "ignorePaths": ["node_modules", "example/node_modules"]
}
