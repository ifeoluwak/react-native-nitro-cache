+  private static func nitroResponseBodyFields(data: Data, charset: String.Encoding) -> (bodyString: String?, bodyBytes: String?) {
+    let bodyStr = String(data: data, encoding: charset) ?? String(data: data, encoding: .utf8)
+    if let s = bodyStr {
